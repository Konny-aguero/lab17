{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar Backend (Spring Boot)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/iniciar-backend.ps1"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Iniciar Frontend (Angular)",
      "type": "shell",
      "command": "npm.cmd start",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Instalar Dependencias Frontend (npm ci)",
      "type": "shell",
      "command": "npm.cmd ci",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Start All (Backend + Frontend)",
      "dependsOn": [
        "Iniciar Backend (Spring Boot)",
        "Iniciar Frontend (Angular)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
